# Copy to .env and fill real values. Never commit secrets.
# Restart: python server.py

BS_EDITORIAL_EMAIL=arina.atom@gmail.com
BS_PUBLIC_BASE=http://127.0.0.1:5173

# Editorial chat agent (optional LLM — FAQ + manuscript check work without it)
# BS_OPENAI_API_KEY=
# BS_OPENAI_BASE=https://api.openai.com/v1
# BS_OPENAI_MODEL=gpt-4o-mini
# For PDF text extraction in chat pre-check: pip install pypdf

# Google / Gmail — https://console.cloud.google.com/apis/credentials
# Redirect URI: http://127.0.0.1:5173/api/auth/callback/google
BS_OAUTH_GOOGLE_CLIENT_ID=
BS_OAUTH_GOOGLE_CLIENT_SECRET=

# Yandex — https://oauth.yandex.ru/
# Redirect URI: http://127.0.0.1:5173/api/auth/callback/yandex
BS_OAUTH_YANDEX_CLIENT_ID=
BS_OAUTH_YANDEX_CLIENT_SECRET=

# Mail.ru — https://api.mail.ru/sites/my/add
# Redirect URI: http://127.0.0.1:5173/api/auth/callback/mailru
BS_OAUTH_MAILRU_CLIENT_ID=
BS_OAUTH_MAILRU_CLIENT_SECRET=

# ORCID — https://orcid.org/developer-tools
# Redirect URI: http://127.0.0.1:5173/api/auth/callback/orcid
BS_OAUTH_ORCID_CLIENT_ID=
BS_OAUTH_ORCID_CLIENT_SECRET=
